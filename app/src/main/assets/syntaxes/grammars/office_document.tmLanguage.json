{
  "name": "Office Document",
  "scopeName": "text.office.document",
  "patterns": [
    {
      "match": "^(#{1,6})\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.office" },
        "2": { "name": "markup.heading.office" }
      }
    },
    {
      "match": "^(Title|Author|Subject|Modified|Pages|Words|Type):\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.other.metadata.office" },
        "2": { "name": "string.unquoted.metadata.office" }
      }
    },
    {
      "match": "^---+$",
      "name": "punctuation.separator.section.office"
    },
    {
      "match": "^>\\s+(.*)$",
      "name": "markup.quote.office"
    },
    {
      "match": "^\\s*([-*]|\\d+\\.)\\s+",
      "name": "markup.list.office"
    },
    {
      "match": "^\\|[-:\\s|]+\\|\\s*$",
      "name": "keyword.control.table-divider.office"
    },
    {
      "match": "\\|",
      "name": "punctuation.separator.table.office"
    },
    {
      "match": "\\[([^\\]]+)\\]\\(([^)]+)\\)",
      "captures": {
        "1": { "name": "string.other.link.title.office" },
        "2": { "name": "markup.underline.link.office" }
      }
    },
    {
      "match": "\\*\\*[^*]+\\*\\*",
      "name": "markup.bold.office"
    },
    {
      "match": "\\b\\d+(?:[.,]\\d+)?%?\\b",
      "name": "constant.numeric.office"
    }
  ]
}
