{
  "name": "Office Presentation",
  "scopeName": "text.office.presentation",
  "patterns": [
    {
      "match": "^(#{1,6})\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.office" },
        "2": { "name": "markup.heading.office" }
      }
    },
    {
      "match": "^(Presentation|Slides|Notes):\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.other.metadata.office" },
        "2": { "name": "string.unquoted.metadata.office" }
      }
    },
    {
      "match": "^---+$",
      "name": "punctuation.separator.slide.office"
    },
    {
      "match": "^>\\s+(.*)$",
      "name": "comment.line.notes.office"
    },
    {
      "match": "^\\s*([-*]|\\d+\\.)\\s+",
      "name": "markup.list.office"
    },
    {
      "match": "^\\|[-:\\s|]+\\|\\s*$",
      "name": "keyword.control.table-divider.office"
    },
    {
      "match": "\\|",
      "name": "punctuation.separator.table.office"
    },
    {
      "match": "\\b\\d+(?:[.,]\\d+)?%?\\b",
      "name": "constant.numeric.office"
    }
  ]
}
