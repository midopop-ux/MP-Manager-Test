{
  "name": "Office Spreadsheet",
  "scopeName": "text.office.spreadsheet",
  "patterns": [
    {
      "match": "^(#{1,6})\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.office" },
        "2": { "name": "markup.heading.office" }
      }
    },
    {
      "match": "^(Workbook|Sheet|Sheets|Rows|Columns|Note):\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.other.metadata.office" },
        "2": { "name": "string.unquoted.metadata.office" }
      }
    },
    {
      "match": "^\\|[-:\\s|]+\\|\\s*$",
      "name": "keyword.control.table-divider.office"
    },
    {
      "match": "\\|",
      "name": "punctuation.separator.table.office"
    },
    {
      "match": "=[A-Za-z_][A-Za-z0-9_.]*\\([^)]*\\)",
      "name": "support.function.formula.office"
    },
    {
      "match": "\\b(TRUE|FALSE|NULL|N/A|#REF!|#VALUE!|#DIV/0!)\\b",
      "name": "constant.language.office"
    },
    {
      "match": "(?:^|(?<=\\|\\s))[$€£¥]?[-+]?\\d+(?:[.,:/]\\d+)*%?(?=\\s*(?:\\||$))",
      "name": "constant.numeric.cell.office"
    },
    {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.office"
    }
  ]
}
